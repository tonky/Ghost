FROM node:22.23.1-bookworm-slim

ENV NODE_ENV=production

# Set up runtime ghost user (uid 1000) without apt-get / external network dependencies
RUN groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 ghost

WORKDIR /home/ghost

# Copy the pre-hydrated Ghost production closure directly from build context
COPY --chown=nobody:nogroup . ./

RUN chown ghost:ghost /home/ghost && \
    chown nobody:nogroup default && \
    chown -R ghost:ghost content log

ARG GHOST_BUILD_VERSION=""
ENV GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION}

USER ghost

# Public app UMD environment overrides for same-origin routing
ENV portal__url=/content/files/portal/portal.min.js \
    comments__url=/content/files/comments-ui/comments-ui.min.js \
    sodoSearch__url=/content/files/sodo-search/sodo-search.min.js \
    sodoSearch__styles=/content/files/sodo-search/main.css \
    signupForm__url=/content/files/signup-form/signup-form.min.js \
    announcementBar__url=/content/files/announcement-bar/announcement-bar.min.js

EXPOSE 2368

CMD ["node", "index.js"]
